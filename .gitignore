node_modules/
*.tgz
# The desktop app's packages (npm run pack, npm run dist) and the next version that
# checks its update (see app/README.md). The Office runtime payload
# (npm run runtime in app/) is downloaded per machine.
/app/dist-pack/
/app/dist-next/
/app/build/runtime/
/app/build/runtime-cache/

# A DeepSeek Harness checkout for the tests and the test bench.
/deepseek-harness/
/superagent/dsh/src/client/upstream/

# Test bench, local DSH data and the screenshots of dev/check.sh.
.dsh-test*/
.dsh-home/
/shots/
.playwright-mcp/
# Interrupted capability runtime tests can leave isolated build folders behind.
/superagent/.product-capability-runtime-*/

# Extra patterns for scripts/scan.mjs that must not be named in the repository.
.scan-extra

# Persistent data for start.ps1 (profiles, credentials, chats and product files).
/.ds-bot-local/
/.ds-superagent-local/


# Local Docker deployment data.
/docker/data/
/docker/workspace/
/docker/.env
/.env
/docker-compose.override.yml

# Bytecode from the record-browser-gif encoder's local media tests.
__pycache__/

# Local official reference snapshots; project-owned analysis is tracked beside them.
/super-agent-references/dsh-superagent-prototype/
/super-agent-references/super-agent reference/
