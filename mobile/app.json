{
  "expo": {
    "name": "DS SuperAgent",
    "slug": "ds-superagent",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.icefireicer.ds-superagent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.icefireicer.dssuperagent"
    },
    "scheme": "ds-superagent",
    "plugins": [
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "DS SuperAgent uses the camera to scan a pairing QR code.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }]
    ]
  }
}
